# --- 13 BASIC R GRAPHICS DEMONSTRATIONS ---
# i. par() - Set up the plot layout to show 4 plots at once (2 rows, 2 columns)
# Note: par() settings are persistent until the device is closed or reset
par(mfrow = c(2, 2), mar = c(4, 4, 2, 1) + 0.1)
# --- PLOT 1: Histograms and Axis ---
# viii. hist() - Plot a histogram of the HPI score
hist(HPI_PLOT_DATA$HPI,
main = "Distribution of Happy Planet Index (HPI)",
xlab = "HPI Score",
col = "lightblue",
border = "white",
xaxt = 'n') # Suppress default X axis to use custom axis
library(readxl)
library(tidyverse)
# --- 1. DATA LOADING ---
# NOTE: The provided code does NOT use the 'hpi' data for plotting,
# but the path logic below is provided for your local setup.
upload_path <- 'HPI_2024_public_dataset.xlsx'
if (file.exists(upload_path)) {
hpi <- read_excel(upload_path, sheet = "All Data", skip = 1)
} else {
# Message indicates the HPI data is not used but the rest of the demo can run.
message("HPI data file not found. Proceeding with generic R dataset examples.")
}
## Start plotting from basics
# Setting the parameter for 6 plots (3 rows by 2 cols)
# FIX: Set layout first before the first plot is drawn
par(mfrow=c(3, 2))
# Plot 1: Pressure (demonstrates high-level plot and text)
plot(pressure, pch=16, main="Pressure vs. Temperature")
text(150, 600,
"Pressure (mm Hg)\nversus\nTemperature (Celsius)", pos=3, cex=0.8)
# Scatterplot (Plot 2) - Demonstrates plot, lines, points, axis, box, mtext, text
x_scatter <- c(0.5, 2, 4, 8, 12, 16) # Renamed
y1 <- c(1, 1.3, 1.9, 3.4, 3.9, 4.8)
y2 <- c(4, .8, .5, .45, .4, .3)
# Setting label orientation, margins c(bottom, left, top, right) & text size
par(las=1, mar=c(4, 4, 2, 4), cex=.7)
# FIX: Use plot(type='n') to safely initialize the plot window and coordinate system
plot(x_scatter, y1, type='n', ylim=c(0, 6), xlim=range(x_scatter),
axes=FALSE, ann=FALSE)
lines(x_scatter, y1) # ii. lines()
lines(x_scatter, y2)
points(x_scatter, y1, pch=16, cex=2) # iii. points()
points(x_scatter, y2, pch=21, bg="white", cex=2)
par(col="gray50", fg="gray50", col.axis="gray50")
axis(1, at=seq(0, 16, 4)) # iv. axis()
axis(2, at=seq(0, 6, 2))
axis(4, at=seq(0, 6, 2))
box(bty="u") # v. box()
mtext("Travel Time (s)", side=1, line=2, cex=0.8) # vii. mtext()
mtext("Responses per Travel", side=2, line=2, las=0, cex=0.8)
mtext("Responses per Second", side=4, line=2, las=0, cex=0.8)
text(4, 5, "Bird 131") # vi. text()
# Reset par for the next plot
par(mar=c(5.1, 4.1, 4.1, 2.1), col="black", fg="black", col.axis="black", las=0, cex=1)
# Histogram (Plot 3) - Demonstrates hist and lines
Y <- rnorm(50)
Y[Y < -3.5 | Y > 3.5] <- NA
x_norm <- seq(-3.5, 3.5, .1) # Renamed
par(mar=c(4.5, 4.1, 3.1, 0))
hist(Y, breaks=seq(-3.5, 3.5), ylim=c(0, 0.5), # viii. hist()
col="gray80", freq=FALSE, main="Histogram of Normal Data")
library(readxl)
library(tidyverse)
# --- 1. DATA LOADING ---
upload_path <- 'HPI_2024_public_dataset.xlsx'
if (file.exists(upload_path)) {
hpi <- read_excel(upload_path, sheet = "All Data", skip = 1)
} else {
message("HPI data file not found. Proceeding with generic R dataset examples.")
}
## Start plotting from basics
# Setting the parameter for 6 plots (3 rows by 2 cols)
par(mfrow=c(3, 2))
# Plot 1: Pressure (demonstrates high-level plot and text)
plot(pressure, pch=16, main="Pressure vs. Temperature")
text(150, 600,
"Pressure (mm Hg)\nversus\nTemperature (Celsius)", pos=3, cex=0.8)
# Scatterplot (Plot 2) - Demonstrates plot, lines, points, axis, box, mtext, text
x_scatter <- c(0.5, 2, 4, 8, 12, 16)
y1 <- c(1, 1.3, 1.9, 3.4, 3.9, 4.8)
y2 <- c(4, .8, .5, .45, .4, .3)
# FIX: Reduced mar values (c(bottom, left, top, right)) to fit 3x2 grid.
par(las=1, mar=c(3, 3, 2, 3), cex=.7) # Reduced margins from 4 to 3
plot(x_scatter, y1, type='n', ylim=c(0, 6), xlim=range(x_scatter),
axes=FALSE, ann=FALSE)
lines(x_scatter, y1)
lines(x_scatter, y2)
points(x_scatter, y1, pch=16, cex=2)
points(x_scatter, y2, pch=21, bg="white", cex=2)
par(col="gray50", fg="gray50", col.axis="gray50")
axis(1, at=seq(0, 16, 4))
axis(2, at=seq(0, 6, 2))
axis(4, at=seq(0, 6, 2))
box(bty="u")
mtext("Travel Time (s)", side=1, line=1.8, cex=0.7) # Adjusted line and cex
mtext("Responses per Travel", side=2, line=1.8, las=0, cex=0.7)
mtext("Responses per Second", side=4, line=1.8, las=0, cex=0.7)
text(4, 5, "Bird 131")
# Reset par for the next plot
par(mar=c(5.1, 4.1, 4.1, 2.1), col="black", fg="black", col.axis="black", las=0, cex=1)
# Histogram (Plot 3) - Demonstrates hist and lines
Y <- rnorm(50)
Y[Y < -3.5 | Y > 3.5] <- NA
x_norm <- seq(-3.5, 3.5, .1)
par(mar=c(4, 4.1, 3.1, 0)) # FIX: Reduced bottom margin slightly
hist(Y, breaks=seq(-3.5, 3.5), ylim=c(0, 0.5),
col="gray80", freq=FALSE, main="Histogram of Normal Data")
lines(x_norm, dnorm(x_norm), lwd=2)
par(mar=c(5.1, 4.1, 4.1, 2.1))
# Barplot (Plot 4)
par(mar=c(4, 4.1, 3, 2.1)) # FIX: Adjusted margins for better fit
midpts <- barplot(VADeaths,
col=gray(0.1 + seq(1, 9, 2)/11),
names.arg=rep("", 4),
main="Barplot of VADeaths Data")
mtext(sub(" ", "\n", colnames(VADeaths)),
at=midpts, side=1, line=0.5, cex=0.5)
text(rep(midpts, each=5), apply(VADeaths, 2, cumsum) - VADeaths/2,
VADeaths,
col=rep(c("white", "black"), times=3:2),
cex=0.8)
par(mar=c(5.1, 4.1, 4.1, 2.1))
# Boxplot (Plot 5)
par(mar=c(4, 4.1, 3, 2.1)) # FIX: Adjusted margins
boxplot(len ~ dose, data = ToothGrowth,
boxwex = 0.25, at = 1:3 - 0.2,
subset= supp == "VC", col="white",
xlab="",
ylab="Tooth Length (mm)", ylim=c(0,35),
main="Tooth Growth by Supplement Type and Dose")
mtext("Vitamin C dose (mg)", side=1, line=2.5, cex=0.8)
boxplot(len ~ dose, data = ToothGrowth, add = TRUE,
boxwex = 0.25, at = 1:3 + 0.2,
col = "gray90",
subset= supp == "OJ")
legend(1, 9, c("Ascorbic acid", "Orange juice"),
fill = c("white", "gray90"),
bty="n", cex=0.8)
par(mar=c(5.1, 4.1, 4.1, 2.1))
# Persp (Plot 6)
x_persp <- seq(-10, 10, length= 30)
y_persp <- x_persp
f <- function(x_p, y_p) { r <- sqrt(x_p^2+y_p^2); 10 * sin(r)/r }
z <- outer(x_persp, y_persp, f)
z[is.na(z)] <- 1
par(mar=c(0, 0, 0, 0), lwd=0.5) # Kept minimum margins for 3D plot
persp(x_persp, y_persp, z, theta = 30, phi = 30,
expand = 0.5, main="3D Perspective Plot",
xlab="X Axis", ylab="Y Axis", zlab="Z Axis")
par(mar=c(5.1, 4.1, 4.1, 2.1), lwd=1)
# Piechart (Plot 7 - Starts a new device page)
par(mfrow=c(1,1), mar=c(0, 2, 3, 2), xpd=FALSE, cex=1)
pie.sales <- c(0.12, 0.3, 0.26, 0.16, 0.04, 0.12)
names(pie.sales) <- c("Blueberry", "Cherry",
"Apple", "Boston Cream", "Other", "Vanilla")
pie(pie.sales, col = gray(seq(0.3,1.0,length=6)), main="Pie Chart of Sales")
par(mar=c(5.1, 4.1, 4.1, 2.1))
